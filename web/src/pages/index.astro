---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import FotoAncha from '../components/FotoAncha.astro';
import Pendiente from '../components/Pendiente.astro';
import { negocio, servicios, equipo } from '../data/negocio';
import { fotos } from '../data/fotos';

const horarioTexto = negocio.franjas.map((f) => `${f.desde.replace(/^0/, '')}–${f.hasta}`).join(' · ');
const dias = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
const diaIdx = [1, 2, 3, 4, 5, 6, 0];
const tel = negocio.telefono;
const wa = negocio.whatsapp;
const ig = negocio.instagram;
const diasConfirmados = negocio.diasAbierto != null;

const flecha = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';

const datosReserva = JSON.stringify({
  servicios: servicios.map((s) => ({ id: s.id, nombre: s.nombre, minutos: s.minutos, precio: s.precio })),
  equipo: equipo.map((b, i) => ({ id: b.id, nombre: b.nombre ?? `Barbero ${i + 1}` })),
  franjas: negocio.franjas,
  diasAbierto: negocio.diasAbierto,
});
---
<Base>
  <header class="nav" data-nav>
    <div class="wrap nav__in">
      <a class="nav__logo" href="#inicio" aria-label="Llano Peluqueros, inicio">Llano</a>
      <nav class="nav__links" aria-label="Principal">
        <a href="#reserva">Precios</a>
        <a href="#trabajos">Trabajos</a>
        <a href="#visita">Visítanos</a>
        <a class="btn btn--primary" href="#reserva">Reservar cita</a>
      </nav>
      <button class="nav__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-abrir>
        Menú
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </header>

  <div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menú" data-menu>
    <div class="menu__top">
      <span class="nav__logo">Llano</span>
      <button class="nav__menu" type="button" data-menu-cerrar>
        Cerrar
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <ul class="menu__list">
      <li><a href="#reserva">Precios</a></li>
      <li><a href="#trabajos">Trabajos</a></li>
      <li><a href="#visita">Visítanos</a></li>
    </ul>
    <a class="btn btn--primary" href="#reserva">Reservar cita</a>
  </div>

  <main id="contenido">
    <!-- HERO -->
    <section class="hero" id="inicio" aria-labelledby="t-hero">
      <FotoAncha class="hero__bg" foto={fotos.hero} escritorio={16 / 9} movil={3 / 4} eager />
      <div class="wrap hero__in">
        <div class="hero__copy">
          <h1 class="display hero__title" id="t-hero">
            <span class="hero__line"><span>Llano</span></span>
            <span class="hero__line"><span>Peluqueros</span></span>
          </h1>
          <p class="lead" data-in style="--i:0">Corte y barba para hombre en la Calle Velázquez, Gijón.</p>
          <div class="hero__actions" data-in style="--i:1">
            <a class="btn btn--primary" href="#reserva" data-cta-hero>Reservar cita <Fragment set:html={flecha} /></a>
          </div>
          <p class="estado" data-estado data-in style="--i:2">
            <span class="estado__dot" aria-hidden="true"></span>
            <span data-estado-texto>Horario <strong>{horarioTexto}</strong></span>
          </p>
        </div>
      </div>
    </section>

    <!-- RESERVA -->
    <section class="sec sec--rojo" id="reserva" aria-labelledby="t-reserva">
      <div class="wrap">
        <div class="sec__head">
          <h2 class="h2" id="t-reserva">Precios y cita</h2>
          <p class="lead">Elige un servicio para empezar.</p>
        </div>
        <div class="reserva" data-reserva={datosReserva}>
          <ol class="pasos" aria-label="Pasos de la reserva">
            <li data-paso-ind="1" data-estado="actual"><span>1</span><span>Servicio</span></li>
            <li data-paso-ind="2"><span>2</span><span>Barbero</span></li>
            <li data-paso-ind="3"><span>3</span><span>Día y hora</span></li>
            <li data-paso-ind="4"><span>4</span><span>Confirmar</span></li>
          </ol>

          <div class="panel" aria-live="polite">
            <div class="paso" data-paso="1">
              <h3 class="sr-only paso__titulo">Servicios y precios</h3>
              <ul class="filas" role="group" aria-label="Servicio">
                {servicios.map((s) => (
                  <li>
                    <button class="fila" type="button" aria-pressed="false" data-opcion="servicio" data-valor={s.id}>
                      <span class="fila__nombre">{s.nombre}</span>
                      <span class="fila__datos">
                        {s.precio != null && s.minutos != null ? (
                          <><span class="fila__dur">{s.minutos} min</span><span class="fila__precio">{s.precio} €</span></>
                        ) : (
                          <Pendiente texto="PENDIENTE precio y duración" />
                        )}
                      </span>
                      <svg class="fila__flecha" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </button>
                  </li>
                ))}
              </ul>
            </div>

            <div class="paso" data-paso="2" hidden>
              <h3 class="h3 paso__titulo">¿Con quién?</h3>
              <div class="opciones opciones--dos" role="group" aria-label="Barbero">
                <button class="opcion" type="button" aria-pressed="false" data-opcion="barbero" data-valor="cualquiera">
                  <span>Me da igual</span><small>El primero libre</small>
                </button>
                {equipo.map((b, i) => (
                  <button class="opcion" type="button" aria-pressed="false" data-opcion="barbero" data-valor={b.id}>
                    <span>{b.nombre ?? `Barbero ${i + 1}`}</span>
                  </button>
                ))}
              </div>
              <div class="paso__pie"><button class="volver" type="button" data-volver>← Volver</button></div>
            </div>

            <div class="paso" data-paso="3" hidden>
              <h3 class="h3 paso__titulo">¿Cuándo?</h3>
              <div class="dias" role="group" aria-label="Día" data-dias></div>
              <div class="opciones opciones--dos" role="group" aria-label="Hora" data-horas></div>
              <div class="paso__pie"><button class="volver" type="button" data-volver>← Volver</button></div>
            </div>

            <div class="paso" data-paso="4" hidden>
              <h3 class="h3 paso__titulo">Tu cita</h3>
              <dl class="resumen" data-resumen></dl>
              <p class="aviso">La reserva online está en camino: todavía no se envía. <span class="pend">[PENDIENTE] sistema de reservas</span></p>
              <p class="muted alternativa">Mientras tanto, ven directamente: {negocio.calle}, {negocio.ciudad}. <a class="link" href={negocio.mapa} rel="noopener" target="_blank">Cómo llegar</a></p>
              <div class="paso__pie">
                <button class="volver" type="button" data-volver>← Volver</button>
                <button class="btn btn--primary" type="button" disabled>Confirmar reserva</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>



    <!-- TRABAJOS -->
    <section class="sec" id="trabajos" aria-labelledby="t-trabajos">
      <div class="wrap">
        <div class="sec__head">
          <h2 class="h2" id="t-trabajos">Así trabajamos</h2>
          {ig ? (
            <a class="link" href={`https://www.instagram.com/${ig}/`} rel="noopener" target="_blank">Más en Instagram @{ig}</a>
          ) : (
            <p class="muted">Más en Instagram <Pendiente texto="PENDIENTE @usuario" /></p>
          )}
        </div>
        <div class="trabajos">
          <Foto foto={fotos.trabajo1} ratio="4 / 5" sizes="(max-width: 860px) 100vw, 40vw" />
          <Foto foto={fotos.trabajo2} ratio="16 / 9" sizes="(max-width: 860px) 50vw, 55vw" />
          <Foto foto={fotos.trabajo3} ratio="16 / 9" sizes="(max-width: 860px) 50vw, 55vw" />
        </div>
      </div>
    </section>


    <!-- VISITA -->
    <section class="sec" id="visita" aria-labelledby="t-visita">
      <div class="wrap">
        <h2 class="direccion-h" id="t-visita">
          <span class="sr-only">Visítanos: </span>
          <a class="direccion" href={negocio.mapa} rel="noopener" target="_blank">
            {negocio.calle},<br />{negocio.ciudad}
            <span class="sr-only">(abre Google Maps)</span>
          </a>
        </h2>
        <div class="visita">
          <div>
            {diasConfirmados ? (
            <dl class="horario" aria-label="Horario">
              {dias.map((d, i) => (
                <div data-dia={diaIdx[i]}>
                  <dt>{d}</dt>
                  <dd>{negocio.diasAbierto == null ? horarioTexto : negocio.diasAbierto.includes(diaIdx[i]) ? horarioTexto : 'Cerrado'}</dd>
                </div>
              ))}
            </dl>
            ) : (
              <dl class="horario" aria-label="Horario">
                <div><dt>Mañanas</dt><dd>{negocio.franjas[0].desde.replace(/^0/, '')}–{negocio.franjas[0].hasta}</dd></div>
                <div><dt>Tardes</dt><dd>{negocio.franjas[1].desde}–{negocio.franjas[1].hasta}</dd></div>
                <div><dt>Días</dt><dd><Pendiente texto="PENDIENTE días" /></dd></div>
              </dl>
            )}
            <p class="lead visita__texto">Ven directamente o pide cita para no esperar.</p>
            <p class="muted">
              Teléfono: {tel ? <a class="link" href={`tel:${tel}`}>{tel}</a> : <Pendiente />}
            </p>
            <p class="muted opiniones-nota">Opiniones de clientes: <Pendiente texto="PENDIENTE reseñas reales" /></p>
            <div class="visita__acciones">
              <a class="btn btn--ghost" href={negocio.mapa} rel="noopener" target="_blank">Cómo llegar <Fragment set:html={flecha} /></a>
              {tel && <a class="btn btn--ghost" href={`tel:${tel}`}>Llamar</a>}
            </div>
          </div>
          <Foto
            ratio="4 / 3"
            local={{
              src: '/img/fachada-680.webp',
              srcset: '/img/fachada-680.webp 680w, /img/fachada-1020.webp 1020w',
              alt: 'Fachada de Llano Peluqueros Caballeros en la Calle Velázquez, Gijón',
              ancho: 680,
              alto: 510,
            }}
            sizes="(max-width: 860px) 100vw, 45vw"
          />
        </div>
      </div>
    </section>

  </main>

  <footer class="pie">
    <div class="wrap">
      <div class="pie__grid">
        <div>
          <p class="pie__titulo">Dirección</p>
          <a class="link" href={negocio.mapa} rel="noopener" target="_blank" style="font-size:1.25rem">{negocio.calle}, {negocio.ciudad}</a>
        </div>
        <div>
          <p class="pie__titulo">Página</p>
          <ul class="pie__lista">
            <li><a href="#reserva">Precios</a></li>
            <li><a href="#trabajos">Trabajos</a></li>
            <li><a href="#visita">Visítanos</a></li>
          </ul>
        </div>
        <div>
          <p class="pie__titulo">Contacto</p>
          <ul class="pie__lista">
            <li>{tel ? <a href={`tel:${tel}`}>{tel}</a> : <Pendiente texto="PENDIENTE teléfono" />}</li>
            <li>{ig ? <a href={`https://www.instagram.com/${ig}/`} rel="noopener" target="_blank">Instagram</a> : <Pendiente texto="PENDIENTE Instagram" />}</li>
          </ul>
        </div>
      </div>
      <div class="pie__legal">
        <span>© {new Date().getFullYear()} {negocio.nombre}</span>
        <span>Fotos de {Object.values(fotos).map((f, i, all) => (
          <>{i > 0 && (i === all.length - 1 ? ' y ' : ', ')}<a href={`${f.autorUrl}?utm_source=llano_peluqueros&utm_medium=referral`} rel="noopener" target="_blank">{f.autor}</a></>
        ))} en <a href="https://unsplash.com/?utm_source=llano_peluqueros&utm_medium=referral" rel="noopener" target="_blank">Unsplash</a></span>
        <nav aria-label="Legal">
          <a href="/aviso-legal/">Aviso legal</a>
          <a href="/privacidad/">Privacidad</a>
        </nav>
      </div>
    </div>
  </footer>

  <nav class="barra" aria-label="Acciones rápidas" data-barra>
    <a class="btn btn--primary" href="#reserva">Reservar</a>
    {wa ? (
      <a class="btn btn--ghost" href={`https://wa.me/${wa.replace(/\D/g, '')}`} rel="noopener" target="_blank">WhatsApp</a>
    ) : (
      <a class="btn btn--ghost" href={negocio.mapa} rel="noopener" target="_blank">Cómo llegar</a>
    )}
    {tel && <a class="btn btn--ghost" href={`tel:${tel}`}>Llamar</a>}
  </nav>
</Base>

<script>
  import { iniciar } from '../scripts/app';
  iniciar();
</script>
