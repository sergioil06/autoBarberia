---
// Hueco de fotografía. Con `foto` muestra la imagen; sin ella, un marcador
// visible con la foto que hay que hacer.
import { src as srcDe, srcset as srcsetDe, type FotoStock } from '../data/fotos';

type FotoLocal = { src: string; srcset?: string; alt: string; ancho: number; alto: number };

interface Props {
  foto?: FotoStock | null;
  local?: FotoLocal | null; // foto propia del negocio, en /public
  ratio?: string; // p. ej. '4 / 5'
  sizes?: string;
  falta?: string;
  class?: string;
  eager?: boolean;
}
const { foto, local, ratio = '4 / 5', sizes = '(max-width: 860px) 100vw, 45vw', falta = '', class: cls = '', eager = false } = Astro.props;
const [a, b] = ratio.split('/').map((n) => Number(n.trim()));
const r = a / b;
---
<figure class:list={['foto', cls, { 'foto--falta': !foto && !local }]} style={`--r: ${ratio}`}>
  {local ? (
    <img src={local.src} srcset={local.srcset} sizes={sizes} width={local.ancho} height={local.alto} alt={local.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : foto ? (
    <img
      src={srcDe(foto, r)}
      srcset={srcsetDe(foto, r)}
      sizes={sizes}
      width="1200"
      height={Math.round(1200 / r)}
      alt={foto.alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <div class="foto__falta" role="img" aria-label={`Foto pendiente: ${falta}`}>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
      <span class="pend">[PENDIENTE] Foto</span>
      <span class="foto__que">{falta}</span>
    </div>
  )}
</figure>
